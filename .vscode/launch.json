{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Click to Call",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ClickToCall/bin/Debug/net10.0-windows/ClickToCall.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Mock-Telefon",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ClickToCall/bin/Debug/net10.0-windows/ClickToCall.exe",
      "args": ["--mock"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Mock-Telefon mit Login (admin / 1234)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ClickToCall/bin/Debug/net10.0-windows/ClickToCall.exe",
      "args": ["--mock-login"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Mock-Telefon – Einrichtung von vorn",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ClickToCall/bin/Debug/net10.0-windows/ClickToCall.exe",
      "args": ["--mock-login", "--mock-reset"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Mock-Telefon Yealink (admin / 1234)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ClickToCall/bin/Debug/net10.0-windows/ClickToCall.exe",
      "args": ["--mock-yealink"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Click to Call (tel: link)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ClickToCall/bin/Debug/net10.0-windows/ClickToCall.exe",
      "args": ["tel:+49 30 1234567"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
