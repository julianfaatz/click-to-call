{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "src/ClickToCall", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "ClickToCall.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package (installer)",
      "type": "shell",
      "command": "./build.ps1",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-ExecutionPolicy", "Bypass", "-File"] } },
      "problemMatcher": []
    }
  ]
}
