<UserControl x:Class="ClickToCallForSnom.UI.Pages.HotkeyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
             xmlns:ui="clr-namespace:ClickToCallForSnom.UI">
    <StackPanel>
        <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{loc:Tr Hotkey.Title}" />
            <ui:HelpTip Margin="10,4,0,0" Help="{loc:Tr Hotkey.Intro}" />
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox Content="{loc:Tr Hotkey.Enabled}" IsChecked="{Binding HotkeyEnabled}" />

                <Grid Margin="0,14,0,0" IsEnabled="{Binding HotkeyEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:LabelWithHelp Label="{loc:Tr Hotkey.Combination}" Help="{loc:Tr Hotkey.BoxHint}" />
                    <TextBox x:Name="HotkeyBox"
                             Grid.Column="1"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             FontWeight="SemiBold"
                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <Button Grid.Column="2" Margin="8,0,0,0" Click="Reset_Click" Content="{loc:Tr Hotkey.Reset}" />
                </Grid>
                <TextBlock x:Name="HotkeyStatus" Margin="180,6,0,0" FontSize="12" />

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal" IsEnabled="{Binding HotkeyEnabled}">
                    <CheckBox Content="{loc:Tr Hotkey.ClipboardFallback}" IsChecked="{Binding HotkeyUseClipboardFallback}" />
                    <ui:HelpTip Help="{loc:Tr Hotkey.ClipboardFallbackHelp}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
