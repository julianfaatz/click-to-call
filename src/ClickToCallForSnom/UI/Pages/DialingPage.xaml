<UserControl x:Class="ClickToCallForSnom.UI.Pages.DialingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
             xmlns:ui="clr-namespace:ClickToCallForSnom.UI">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Dialing.Title}" />

        <!-- ===== Calls ===== -->
        <ui:SettingCard Icon="&#xE8BD;" Title="{loc:Tr Dialing.ConfirmLinks}" Description="{loc:Tr Dialing.ConfirmLinksHint}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConfirmLinkCalls}" />
        </ui:SettingCard>

        <ui:SettingCard Icon="&#xEA8F;" Title="{loc:Tr Dialing.ShowNotification}" Description="{loc:Tr Dialing.ShowNotificationHint}">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="SecondsBox"
                          Width="140"
                          Margin="0,0,16,0"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding NotificationSeconds}"
                          IsEnabled="{Binding ShowCallNotification}" />
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowCallNotification}" />
            </StackPanel>
        </ui:SettingCard>

        <ui:SettingCard x:Name="IdentityCard" Icon="&#xE77B;" Title="{loc:Tr Identity.ShowSelection}" Description="{loc:Tr Identity.ShowSelectionHelp}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowIdentitySelection}" />
        </ui:SettingCard>

        <!-- ===== Hotkey ===== -->
        <TextBlock x:Name="HotkeySection" Style="{StaticResource SectionHeader}" Text="{loc:Tr Hotkey.Title}" />

        <ui:SettingCard Icon="&#xE765;" Title="{loc:Tr Hotkey.Enabled}" Description="{loc:Tr Hotkey.Intro}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HotkeyEnabled}" />
        </ui:SettingCard>

        <ui:SettingCard Icon="&#xE92E;" Title="{loc:Tr Hotkey.Combination}" Description="{loc:Tr Hotkey.BoxHint}" IsEnabled="{Binding HotkeyEnabled}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HotkeyBox"
                             Width="170"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             FontWeight="SemiBold"
                             HorizontalContentAlignment="Center"
                             Cursor="Hand"
                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <Button Margin="8,0,0,0" Click="ResetHotkey_Click" ToolTip="{loc:Tr Hotkey.Reset}">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="HotkeyStatus" Margin="0,6,0,0" FontSize="12" MaxWidth="220" HorizontalAlignment="Left" TextWrapping="Wrap" />
            </StackPanel>
        </ui:SettingCard>

        <ui:SettingCard Icon="&#xE77F;" Title="{loc:Tr Hotkey.ClipboardFallback}" Description="{loc:Tr Hotkey.ClipboardFallbackHelp}" IsEnabled="{Binding HotkeyEnabled}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HotkeyUseClipboardFallback}" />
        </ui:SettingCard>

        <!-- ===== Links ===== -->
        <TextBlock x:Name="LinksSection" Style="{StaticResource SectionHeader}" Text="{loc:Tr Protocols.Title}" />

        <ui:SettingCard x:Name="DefaultAppCard" Icon="&#xE71B;" Title="{loc:Tr Protocols.DefaultTitle}">
            <Button x:Name="DefaultAppButton" MinWidth="110" Click="OpenDefaultApps_Click" />
            <ui:SettingCard.Footer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Width="70" VerticalAlignment="Center" FontWeight="SemiBold" Text="tel:" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CardDescription}" Text="{loc:Tr Protocols.Tel}" />
                    <TextBlock x:Name="TelStatus" Grid.Column="2" Margin="12,0,16,0" FontSize="12" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HandleTel}" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="callto:" />
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CardDescription}" Text="{loc:Tr Protocols.Callto}" />
                    <TextBlock x:Name="CalltoStatus" Grid.Row="2" Grid.Column="2" Margin="12,0,16,0" FontSize="12" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="2" Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HandleCallto}" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="sip:" />
                    <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CardDescription}" Text="{loc:Tr Protocols.Sip}" />
                    <TextBlock x:Name="SipStatus" Grid.Row="4" Grid.Column="2" Margin="12,0,16,0" FontSize="12" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="4" Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HandleSip}" />
                </Grid>
            </ui:SettingCard.Footer>
        </ui:SettingCard>

        <!-- ===== Number formatting ===== -->
        <TextBlock x:Name="NumbersSection" Style="{StaticResource SectionHeader}" Text="{loc:Tr Dialing.NormalizeTitle}" />

        <ui:SettingCard x:Name="CountryCard" Icon="&#xE909;" Title="{loc:Tr Dialing.ConvertOwnCountry}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="+" />
                <TextBox Width="60" Margin="0,0,16,0" IsEnabled="{Binding ConvertOwnCountryCode}" Text="{Binding OwnCountryCode, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConvertOwnCountryCode}" />
            </StackPanel>
        </ui:SettingCard>

        <ui:SettingCard Icon="&#xE774;" Title="{loc:Tr Dialing.PlusToZeros}" Description="{loc:Tr Dialing.PlusToZerosHelp}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConvertPlusToZeros}" />
        </ui:SettingCard>

        <ui:SettingCard Icon="&#xE80F;" Title="{loc:Tr Dialing.OutsideLine}" Description="{loc:Tr Dialing.OutsideLineHint}">
            <TextBox Width="60" Text="{Binding OutsideLinePrefix, UpdateSourceTrigger=PropertyChanged}" />
            <ui:SettingCard.Footer>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{loc:Tr Dialing.OutsideLineFrom}" />
                    <TextBox Width="60" Margin="8,0" Text="{Binding OutsideLineMinLength, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="{loc:Tr Dialing.Digits}" />
                </StackPanel>
            </ui:SettingCard.Footer>
        </ui:SettingCard>

        <Border Margin="0,8,0,0" Style="{StaticResource Card}" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Style="{StaticResource CardDescription}" Text="{loc:Tr Dialing.TryIt}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TryInput" Text="+49 (0)30 123 456-78" TextChanged="TryInput_TextChanged" />
                    <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE72A;" />
                    <TextBlock x:Name="TryOutput" Grid.Column="2" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
