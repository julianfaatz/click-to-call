<UserControl x:Class="ClickToCallForSnom.UI.Pages.DialingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
             xmlns:ui="clr-namespace:ClickToCallForSnom.UI">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,20" Text="{loc:Tr Dialing.Title}" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{loc:Tr Dialing.ConfirmLinks}" IsChecked="{Binding ConfirmLinkCalls}" />
                    <ui:HelpTip Help="{loc:Tr Dialing.ConfirmLinksHint}" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" Content="{loc:Tr Dialing.ShowNotification}" IsChecked="{Binding ShowCallNotification}" />
                    <TextBox Width="56"
                             Margin="10,0,8,0"
                             IsEnabled="{Binding ShowCallNotification}"
                             Text="{Binding NotificationSeconds, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock VerticalAlignment="Center" Text="{loc:Tr Dialing.Seconds}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="{loc:Tr Dialing.NormalizeTitle}" />
            <ui:HelpTip Help="{loc:Tr Dialing.NormalizeIntro}" />
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" Content="{loc:Tr Dialing.ConvertOwnCountry}" IsChecked="{Binding ConvertOwnCountryCode}" />
                    <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Text="+" />
                    <TextBox Width="56" IsEnabled="{Binding ConvertOwnCountryCode}" Text="{Binding OwnCountryCode, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:HelpTip Help="{loc:Tr Dialing.ConvertOwnCountryHelp}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <CheckBox Content="{loc:Tr Dialing.PlusToZeros}" IsChecked="{Binding ConvertPlusToZeros}" />
                    <ui:HelpTip Help="{loc:Tr Dialing.PlusToZerosHelp}" />
                </StackPanel>

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <ui:LabelWithHelp Margin="0,0,10,0" Label="{loc:Tr Dialing.OutsideLine}" Help="{loc:Tr Dialing.OutsideLineHint}" />
                    <TextBox Width="56" Text="{Binding OutsideLinePrefix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,8,0" VerticalAlignment="Center" Text="{loc:Tr Dialing.OutsideLineFrom}" />
                    <TextBox Width="56" Text="{Binding OutsideLineMinLength, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{loc:Tr Dialing.Digits}" />
                </StackPanel>

                <Border Height="1" Margin="0,18,0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <TextBlock Margin="0,0,0,6" Style="{StaticResource CardDescription}" Text="{loc:Tr Dialing.TryIt}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TryInput" Text="+49 (0)30 123 456-78" TextChanged="TryInput_TextChanged" />
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE72A;" />
                    <TextBlock x:Name="TryOutput" Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
