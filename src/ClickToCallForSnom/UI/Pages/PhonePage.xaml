<UserControl x:Class="ClickToCallForSnom.UI.Pages.PhonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
             xmlns:ui="clr-namespace:ClickToCallForSnom.UI">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,20" Text="{loc:Tr Phone.Title}" />

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" MaxWidth="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:LabelWithHelp Label="{loc:Tr Phone.Host}" Help="{loc:Tr Phone.HostHelp}" />
                <TextBox Grid.Column="1" Text="{Binding PhoneHost, UpdateSourceTrigger=LostFocus}" />

                <ui:LabelWithHelp Grid.Row="2" Label="{loc:Tr Phone.Connection}" Help="{loc:Tr Phone.ConnectionHelp}" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <CheckBox Content="{loc:Tr Phone.UseHttps}" IsChecked="{Binding UseHttps}" />
                    <CheckBox Content="{loc:Tr Phone.IgnoreCert}" IsChecked="{Binding IgnoreCertificateErrors}" IsEnabled="{Binding UseHttps}" />
                </StackPanel>

                <ui:LabelWithHelp Grid.Row="4" Label="{loc:Tr Phone.Username}" Help="{loc:Tr Phone.CredentialsHelp}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=LostFocus}" />

                <ui:LabelWithHelp Grid.Row="6" Label="{loc:Tr Phone.Password}" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="6" Grid.Column="1" PasswordChanged="PasswordBox_PasswordChanged" />

                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TestButton" Click="Test_Click" Content="{loc:Tr Phone.Test}" />
                    <TextBlock x:Name="TestResult" Style="{StaticResource Status}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="0,24,0,8" Orientation="Horizontal">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" Text="{loc:Tr Identity.Title}" />
            <ui:HelpTip Help="{loc:Tr Identity.Intro}" />
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" MaxWidth="340" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:LabelWithHelp Label="{loc:Tr Identity.Default}" />
                <ComboBox x:Name="DefaultIdentityBox"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="DefaultIdentityBox_SelectionChanged" />
                <Button x:Name="RemoveIdentityButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Click="RemoveIdentity_Click"
                        ToolTip="{loc:Tr Identity.Remove}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                </Button>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button x:Name="LoadIdentitiesButton" Click="LoadIdentities_Click" Content="{loc:Tr Identity.Load}" />
                    <TextBlock x:Name="IdentityResult" Style="{StaticResource Status}" />
                </StackPanel>

                <ui:LabelWithHelp Grid.Row="4" Label="{loc:Tr Identity.Manual}" Help="{loc:Tr Identity.ManualHint}" />
                <TextBox x:Name="ManualIdentityBox" Grid.Row="4" Grid.Column="1" />
                <Button Grid.Row="4" Grid.Column="2" Margin="8,0,0,0" Click="AddIdentity_Click" ToolTip="{loc:Tr Identity.Add}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" />
                </Button>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <CheckBox Content="{loc:Tr Identity.ShowSelection}" IsChecked="{Binding ShowIdentitySelection}" />
                    <ui:HelpTip Help="{loc:Tr Identity.ShowSelectionHelp}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
