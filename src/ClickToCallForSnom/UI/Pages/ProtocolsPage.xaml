<UserControl x:Class="ClickToCallForSnom.UI.Pages.ProtocolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
             xmlns:ui="clr-namespace:ClickToCallForSnom.UI">
    <StackPanel>
        <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="{loc:Tr Protocols.Title}" />
            <ui:HelpTip Margin="10,4,0,0" Help="{loc:Tr Protocols.Intro}" />
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="tel:" IsChecked="{Binding HandleTel}" />
                    <ui:HelpTip Help="{loc:Tr Protocols.Tel}" />
                </StackPanel>
                <TextBlock x:Name="TelStatus" Grid.Column="1" Style="{StaticResource Status}" />

                <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
                    <CheckBox Content="callto:" IsChecked="{Binding HandleCallto}" />
                    <ui:HelpTip Help="{loc:Tr Protocols.Callto}" />
                </StackPanel>
                <TextBlock x:Name="CalltoStatus" Grid.Row="1" Grid.Column="1" Style="{StaticResource Status}" />

                <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                    <CheckBox Content="sip:" IsChecked="{Binding HandleSip}" />
                    <ui:HelpTip Help="{loc:Tr Protocols.Sip}" />
                </StackPanel>
                <TextBlock x:Name="SipStatus" Grid.Row="2" Grid.Column="1" Style="{StaticResource Status}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7AC;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center" Text="{loc:Tr Protocols.DefaultTitle}" />
                    <ui:HelpTip Help="{loc:Tr Protocols.DefaultHint}" />
                </StackPanel>
                <Button Grid.Column="2" Click="OpenDefaultApps_Click" Content="{loc:Tr Protocols.OpenDefaultApps}" Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
