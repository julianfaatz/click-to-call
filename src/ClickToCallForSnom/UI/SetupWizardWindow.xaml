<Window x:Class="ClickToCallForSnom.UI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
        xmlns:pages="clr-namespace:ClickToCallForSnom.UI.Pages"
        Title="{loc:Tr Wizard.Title}"
        Width="760"
        Height="640"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="24,12"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StepText" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" MinWidth="100" Click="Back_Click" Content="{loc:Tr Wizard.Back}" />
                    <Button x:Name="NextButton"
                            MinWidth="100"
                            Margin="8,0,0,0"
                            IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}"
                            Click="Next_Click"
                            Content="{loc:Tr Wizard.Next}" />
                    <Button MinWidth="100" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" Content="{loc:Tr Common.Cancel}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Padding="32,24" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Step 1: welcome -->
                <StackPanel x:Name="WelcomePage">
                    <TextBlock Margin="0,0,0,16"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="48"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Text="&#xE717;" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Wizard.WelcomeTitle}" />
                    <TextBlock TextWrapping="Wrap" Text="{loc:Tr Wizard.WelcomeText}" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr General.Language}" />
                        <ComboBox x:Name="LanguageBox"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectionChanged="LanguageBox_SelectionChanged" />
                    </Grid>

                    <TextBlock Margin="0,32,0,0" Style="{StaticResource Hint}" Text="{loc:Tr App.Disclaimer}" />
                </StackPanel>

                <pages:PhonePage x:Name="PhonePage" Visibility="Collapsed" />
                <pages:DialingPage x:Name="DialingPage" Visibility="Collapsed" />
                <pages:HotkeyPage x:Name="HotkeyPage" Visibility="Collapsed" />
                <pages:ProtocolsPage x:Name="ProtocolsPage" Visibility="Collapsed" />

                <!-- Last step: finish -->
                <StackPanel x:Name="FinishPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Wizard.FinishTitle}" />
                    <TextBlock TextWrapping="Wrap" Text="{loc:Tr Wizard.FinishText}" />

                    <CheckBox Margin="0,20,0,0" Content="{loc:Tr General.Autostart}" IsChecked="{Binding Autostart}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr Wizard.TestCallTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Wizard.TestCallHint}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBox x:Name="TestNumberBox" Width="220" />
                        <Button x:Name="TestCallButton" Margin="8,0,0,0" Click="TestCall_Click" Content="{loc:Tr Wizard.TestCall}" />
                        <Button Margin="8,0,0,0" Click="HangUp_Click" Content="{loc:Tr Call.HangUp}" />
                    </StackPanel>
                    <TextBlock x:Name="TestCallStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
