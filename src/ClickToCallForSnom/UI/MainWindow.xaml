<Window x:Class="ClickToCallForSnom.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click to Call for Snom"
        Width="940"
        Height="700"
        MinWidth="760"
        MinHeight="520"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Margin="8,12,4,12">
            <StackPanel DockPanel.Dock="Top" Margin="12,4,0,20" Orientation="Horizontal">
                <Image Width="28" Height="28" Source="/Assets/app.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="Click to Call" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="for Snom" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="VersionText"
                       DockPanel.Dock="Bottom"
                       Margin="12,0,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ListBox x:Name="Nav"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="Nav_SelectionChanged" />
        </DockPanel>

        <!-- Page -->
        <Border Grid.Column="1"
                Margin="0,8,8,8"
                CornerRadius="8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" MaxWidth="780" Margin="36,28" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
