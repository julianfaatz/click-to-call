<Window x:Class="ClickToCallForSnom.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClickToCallForSnom.Core"
        xmlns:pages="clr-namespace:ClickToCallForSnom.UI.Pages"
        Title="{loc:Tr Settings.Title}"
        Width="780"
        Height="680"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="24,12"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="110"
                        IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="Save_Click"
                        Content="{loc:Tr Common.Save}" />
                <Button MinWidth="110"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="{loc:Tr Common.Cancel}" />
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12,8,12,0">
            <TabItem Header="{loc:Tr Tab.Phone}">
                <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                    <pages:PhonePage />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Tr Tab.Dialing}">
                <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                    <pages:DialingPage />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Tr Tab.Hotkey}">
                <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                    <pages:HotkeyPage />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Tr Tab.Protocols}">
                <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                    <pages:ProtocolsPage />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Tr Tab.General}">
                <ScrollViewer Padding="12,16" VerticalScrollBarVisibility="Auto">
                    <pages:GeneralPage />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
