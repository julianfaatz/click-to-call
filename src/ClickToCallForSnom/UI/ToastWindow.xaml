<Window x:Class="ClickToCallForSnom.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click to Call for Phones"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border Margin="12"
            Padding="16,14"
            CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="IconText"
                       Grid.RowSpan="2"
                       Margin="0,2,12,0"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="22"
                       Text="&#xE717;" />

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="2"
                    Margin="8,-6,-8,0"
                    Padding="6,2"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Close_Click"
                    ToolTip="{Binding CloseText, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE711;" />
            </Button>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="ActionsPanel"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal" />
        </Grid>
    </Border>
</Window>
