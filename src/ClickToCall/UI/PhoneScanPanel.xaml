<UserControl x:Class="ClickToCall.UI.PhoneScanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ClickToCall.UI"
             Visibility="Collapsed">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:ScanRadar x:Name="ScanRadar" Margin="0,4,20,4" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ScanStatus" TextWrapping="Wrap" Style="{StaticResource CardDescription}" />
                <TextBlock x:Name="ScanDetail" Margin="0,6,0,0" Style="{StaticResource Hint}" />
            </StackPanel>
        </Grid>
        <WrapPanel x:Name="ScanResults" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
