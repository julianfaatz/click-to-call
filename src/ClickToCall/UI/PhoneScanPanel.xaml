<UserControl x:Class="ClickToCall.UI.PhoneScanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCall.Core"
             xmlns:ui="clr-namespace:ClickToCall.UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:ScanRadar x:Name="ScanRadar" Margin="0,4,28,4" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Margin="0,8,0,0">
            <TextBlock x:Name="ScanStatus"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ScanDetail" Margin="0,4,0,0" Style="{StaticResource Hint}" />

            <!-- The phones found, live while scanning -->
            <ScrollViewer MaxHeight="280"
                          Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="420" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ScanResults" />
                </Grid>
            </ScrollViewer>

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <Button x:Name="ScanAgainButton"
                        Margin="0,0,24,0"
                        Style="{StaticResource LinkButton}"
                        Click="ScanAgain_Click"
                        Content="{loc:Tr Home.ScanAgain}"
                        Visibility="Collapsed" />
                <Button Style="{StaticResource LinkButton}" Click="Manual_Click" Content="{loc:Tr Home.ManualLink}" />
            </StackPanel>
            <TextBlock x:Name="Message"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
