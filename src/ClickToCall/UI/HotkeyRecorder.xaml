<UserControl x:Class="ClickToCall.UI.HotkeyRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCall.Core">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="Box"
                     Width="170"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     FontWeight="SemiBold"
                     HorizontalContentAlignment="Center"
                     Cursor="Hand"
                     GotKeyboardFocus="Box_GotKeyboardFocus"
                     LostKeyboardFocus="Box_LostKeyboardFocus"
                     PreviewKeyDown="Box_PreviewKeyDown"
                     PreviewKeyUp="Box_PreviewKeyUp" />
            <Button Margin="8,0,0,0" Click="Reset_Click" ToolTip="{loc:Tr Hotkey.Reset}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" />
            </Button>
        </StackPanel>
        <TextBlock x:Name="Status" Margin="0,6,0,0" FontSize="12" MaxWidth="220" HorizontalAlignment="Left" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
