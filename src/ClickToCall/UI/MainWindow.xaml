<Window x:Class="ClickToCall.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click to Call"
        Width="1060"
        Height="780"
        MinWidth="900"
        MinHeight="640"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Margin="8,12,4,12">
            <StackPanel DockPanel.Dock="Top" Margin="12,4,0,20" Orientation="Horizontal">
                <Image Width="28" Height="28" Source="/Assets/app.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="Click to Call" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" x:Name="Tagline" />
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="Nav"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="Nav_SelectionChanged" />
        </DockPanel>

        <!-- Page -->
        <Border Grid.Column="1"
                Margin="0,8,8,8"
                CornerRadius="8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" MaxWidth="1100" Margin="40,32" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
