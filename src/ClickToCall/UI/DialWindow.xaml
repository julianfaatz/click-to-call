<Window x:Class="ClickToCall.UI.DialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClickToCall.Core"
        Title="{loc:Tr Dial.WindowTitle}"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Margin="12"
            Padding="20,16,20,18"
            CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="18"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Text="&#xE717;" />
                <TextBlock x:Name="HeaderText"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Tr Dial.Title}" />
            </DockPanel>

            <TextBox x:Name="NumberBox"
                     FontSize="22"
                     Padding="10,6"
                     TextChanged="NumberBox_TextChanged" />

            <TextBlock x:Name="PreviewText"
                       Margin="2,6,0,0"
                       Style="{StaticResource Hint}" />

            <!-- Shown while the number box is empty -->
            <StackPanel x:Name="RecentPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Margin="2,0,0,6" Style="{StaticResource Hint}" Text="{loc:Tr Dial.Recent}" />
                <WrapPanel x:Name="RecentList" />
            </StackPanel>

            <StackPanel x:Name="IdentityPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Margin="0,0,0,4" Text="{loc:Tr Dial.Identity}" />
                <ComboBox x:Name="IdentityBox"
                          HorizontalAlignment="Stretch"
                          DisplayMemberPath="DisplayName" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DialButton"
                        HorizontalAlignment="Stretch"
                        IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="Dial_Click"
                        Content="{loc:Tr Dial.Dial}" />
                <Button Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="{loc:Tr Dial.Cancel}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
