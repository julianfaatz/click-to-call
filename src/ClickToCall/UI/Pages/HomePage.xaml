<UserControl x:Class="ClickToCall.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCall.Core"
             xmlns:ui="clr-namespace:ClickToCall.UI">
    <UserControl.Resources>
        <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="28,24" />
        </Style>
        <Style x:Key="StepIconCircle" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StepIcon" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="InstructionNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="SubtitleText"
                   Margin="0,-14,0,24"
                   FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{loc:Tr Home.SetupSubtitle}" />

        <!-- ===== Step indicator (filled in code) ===== -->
        <Grid x:Name="Stepper" Margin="0,0,0,24" />

        <!-- ===== Phone card (step 1 and everyday use) ===== -->
        <Border x:Name="PhoneCard" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource StepIconCircle}" VerticalAlignment="Center">
                        <TextBlock x:Name="PhoneIcon" Style="{StaticResource StepIcon}" Text="&#xE717;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PhoneTitle" Style="{StaticResource StepTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock x:Name="PhoneSubtitle" Style="{StaticResource StepText}" Margin="0,2,0,0" />
                        <StackPanel x:Name="StatusPill" Margin="0,6,0,0" Orientation="Horizontal" Visibility="Collapsed">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLabel" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <!-- Something the user has to set up on this kind of phone (e.g. Yealink remote control) -->
                            <ui:HelpTip x:Name="PhoneHintTip" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="RecheckButton"
                                Margin="0,0,8,0"
                                Click="Recheck_Click"
                                ToolTip="{loc:Tr Home.Recheck}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" />
                        </Button>
                        <Button x:Name="ChangeButton" Click="ShowConnectForm_Click" Content="{loc:Tr Home.Change}" />
                    </StackPanel>
                </Grid>

                <!-- Line (identity) selection -->
                <Grid x:Name="LinePanel" Margin="76,16,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="360" />
                    </Grid.ColumnDefinitions>
                    <ui:LabelWithHelp Margin="0,0,16,0" Label="{loc:Tr Home.Line}" Help="{loc:Tr Home.LineHelp}" />
                    <ComboBox x:Name="LineBox"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="LineBox_SelectionChanged" />
                </Grid>

                <!-- Connect form -->
                <StackPanel x:Name="ConnectForm" Margin="0,20,0,0" Visibility="Collapsed">
                    <Border Margin="-24,0,-24,20" Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Phone.Host}" />
                        <TextBox x:Name="HostBox" Grid.Column="1" KeyDown="FormBox_KeyDown" />
                        <Button x:Name="ScanButton"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LinkButton}"
                                Click="Scan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE721;" />
                                <TextBlock x:Name="ScanButtonText" VerticalAlignment="Center" Text="{loc:Tr Home.Scan}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,6,0,0" Style="{StaticResource Hint}" Text="{loc:Tr Phone.HostHelp}" />

                        <!-- Scan results -->
                        <StackPanel x:Name="ScanPanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:ScanRadar x:Name="ScanRadar" Margin="0,4,20,4" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ScanStatus" TextWrapping="Wrap" Style="{StaticResource CardDescription}" />
                                    <TextBlock x:Name="ScanDetail" Margin="0,6,0,0" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="ScanResults" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Only shown when the manufacturer could not be recognized, or to change it later -->
                    <Grid x:Name="VendorPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Phone.Vendor}" />
                        <ComboBox x:Name="VendorBox" Grid.Column="1" DisplayMemberPath="Name" />
                    </Grid>

                    <!-- Only shown when the phone asks for a login -->
                    <StackPanel x:Name="CredentialsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <Border Margin="0,0,0,12"
                                Padding="12,10"
                                CornerRadius="4"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,1,10,0" FontFamily="{StaticResource IconFont}" Text="&#xE72E;" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{loc:Tr Home.NeedsLogin}" />
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" MaxWidth="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Phone.Username}" />
                            <TextBox x:Name="UserBox" Grid.Column="1" KeyDown="FormBox_KeyDown" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{loc:Tr Phone.Password}" />
                            <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" KeyDown="FormBox_KeyDown" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="150,16,0,0" Orientation="Horizontal">
                        <Button x:Name="DoConnectButton"
                                MinWidth="110"
                                Style="{DynamicResource AccentButtonStyle}"
                                Click="Connect_Click"
                                Content="{loc:Tr Home.DoConnect}" />
                        <Button x:Name="CancelConnectButton"
                                MinWidth="90"
                                Margin="8,0,0,0"
                                Click="CancelConnect_Click"
                                Content="{loc:Tr Common.Cancel}" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectMessage" Margin="150,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <!-- Setup: phone already connected, user came back to step 1 -->
                <StackPanel x:Name="Step1Next" Margin="76,20,0,0" Orientation="Horizontal" Visibility="Collapsed">
                    <Button MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Next_Click" Content="{loc:Tr Home.Next}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Step 2: links ===== -->
        <Border x:Name="Step2Card" Style="{StaticResource StepCard}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepIconCircle}">
                    <TextBlock Style="{StaticResource StepIcon}" Text="&#xE71B;" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StepTitle}" Text="{loc:Tr Home.StepLinks}" />
                    <TextBlock Style="{StaticResource StepText}" Text="{loc:Tr Home.StepLinksText}" />

                    <!-- How to -->
                    <StackPanel x:Name="Step2Instructions" Margin="0,20,0,0">
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Style="{StaticResource InstructionNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="1" /></Border>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{loc:Tr Home.StepLinksHow1}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <Border Style="{StaticResource InstructionNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="2" /></Border>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{loc:Tr Home.StepLinksHow2}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource InstructionNumber}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="3" /></Border>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{loc:Tr Home.StepLinksHow3}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Already done (user came back to this step) -->
                    <TextBlock x:Name="Step2Done"
                               Margin="0,20,0,0"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               Text="{loc:Tr Home.StepLinksDone}"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="Step2Waiting"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{loc:Tr Home.StepLinksWaiting}"
                               Visibility="Collapsed" />

                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <Button x:Name="Step2Button" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Links_Click" Content="{loc:Tr Home.StepLinksButton}" />
                        <Button x:Name="Step2NextButton" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Next_Click" Content="{loc:Tr Home.Next}" Visibility="Collapsed" />
                        <Button x:Name="Step2SkipButton" Margin="20,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Click="SkipLinks_Click" Content="{loc:Tr Home.SkipStep}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Step 3: test call ===== -->
        <Border x:Name="Step3Card" Style="{StaticResource StepCard}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepIconCircle}">
                    <TextBlock Style="{StaticResource StepIcon}" Text="&#xE8EA;" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StepTitle}" Text="{loc:Tr Home.StepTest}" />
                    <TextBlock Style="{StaticResource StepText}" Text="{loc:Tr Home.StepTestText}" />

                    <Border x:Name="Step3Hint"
                            Margin="0,16,0,0"
                            Padding="12,10"
                            CornerRadius="4"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,1,10,0" FontFamily="{StaticResource IconFont}" Text="&#xE946;" />
                            <TextBlock x:Name="Step3HintText" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <TextBox x:Name="TestNumberBox" Width="240" FontSize="16" VerticalAlignment="Center" KeyDown="DialBox_KeyDown" />
                        <Button x:Name="TestCallButton" Margin="8,0,0,0" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Call_Click" Content="{loc:Tr Home.Call}" />
                    </StackPanel>

                    <!-- The phone accepting the request does not mean it dialed (e.g. Yealink without permission): ask -->
                    <Border x:Name="TestConfirmPanel"
                            Margin="0,16,0,0"
                            Padding="16,12"
                            CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TestConfirmText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="TestWorked_Click" Content="{loc:Tr Home.TestYes}" />
                                <Button MinWidth="90" Margin="8,0,0,0" Click="TestFailed_Click" Content="{loc:Tr Home.TestNo}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TestHelpPanel"
                            Margin="0,16,0,0"
                            Padding="16,12"
                            CornerRadius="6"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr Home.TestFailedTitle}" />
                            <TextBlock x:Name="TestHelpVendor" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="TestHelpNumber" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="TestRetry_Click" Content="{loc:Tr Home.TestRetry}" />
                                <Button Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Click="NumberSettings_Click" Content="{loc:Tr Home.TestNumberSettings}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Margin="0,20,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}" Click="SkipTest_Click" Content="{loc:Tr Home.SkipTest}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Everyday use (after the setup) ===== -->
        <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
            <Border x:Name="DoneBanner"
                    Margin="0,4,0,0"
                    Padding="16,12"
                    CornerRadius="6"
                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,1,12,0"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               Text="&#xE930;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="{loc:Tr Home.DoneTitle}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{loc:Tr Home.DoneText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr Home.ReadyTitle}" />

            <ui:SettingCard Icon="&#xE717;" Title="{loc:Tr Home.DialTitle}" Description="{loc:Tr Home.DialDescription}">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="DialNumberBox" Width="190" VerticalAlignment="Center" KeyDown="DialBox_KeyDown" />
                    <Button x:Name="DialCallButton" Margin="8,0,0,0" MinWidth="90" Style="{DynamicResource AccentButtonStyle}" Click="Call_Click" Content="{loc:Tr Home.Call}" />
                </StackPanel>
            </ui:SettingCard>

            <ui:SettingCard x:Name="LinksTip" Icon="&#xE71B;" Title="{loc:Tr Home.LinksTitle}">
                <Button x:Name="LinksTipButton" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Links_Click" Content="{loc:Tr Home.LinksSet}" />
            </ui:SettingCard>

            <ui:SettingCard x:Name="HotkeyTip" Icon="&#xE765;">
                <Button MinWidth="90" Click="Hotkey_Click" Content="{loc:Tr Home.Change}" />
            </ui:SettingCard>

            <ui:SettingCard Icon="&#xEA8F;" Title="{loc:Tr Home.TrayTitle}" Description="{loc:Tr Home.TrayDescription}" />
        </StackPanel>
    </StackPanel>
</UserControl>
