<UserControl x:Class="ClickToCall.UI.PhoneConnectForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClickToCall.Core"
             xmlns:ui="clr-namespace:ClickToCall.UI"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="ViewTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ViewText" TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="FieldHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Message" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        </Style>
    </UserControl.Resources>

    <!-- One view at a time, each with one question and one main action: search, address, login, manufacturer -->
    <StackPanel Margin="0,20,0,0">
        <Border Margin="-24,0,-24,20" Style="{StaticResource Divider}" />

        <!-- The phone being connected, above the login and the manufacturer selection -->
        <Grid x:Name="TargetBar" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Margin="0,0,12,0"
                    Padding="8,6"
                    VerticalAlignment="Center"
                    Click="Back_Click"
                    ToolTip="{loc:Tr Home.Back}"
                    AutomationProperties.Name="{loc:Tr Home.Back}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE717;" />
                <TextBlock x:Name="TargetModel" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="TargetAddress"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Views">
            <!-- Search the network -->
            <ui:PhoneScanPanel x:Name="SearchView" />

            <!-- Enter the address -->
            <StackPanel x:Name="ManualView" Visibility="Collapsed">
                <TextBlock x:Name="ManualTitle" Style="{StaticResource ViewTitle}" />
                <TextBlock Style="{StaticResource ViewText}" Text="{loc:Tr Phone.HostHelp}" />

                <TextBlock Style="{StaticResource FieldHeader}" Text="{loc:Tr Phone.Host}" />
                <TextBox x:Name="HostBox" Width="280" HorizontalAlignment="Left" KeyDown="HostBox_KeyDown" />

                <!-- Only to change it later; a new phone is recognized automatically -->
                <StackPanel x:Name="VendorPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldHeader}" Text="{loc:Tr Phone.Vendor}" />
                    <ComboBox x:Name="VendorBox" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button x:Name="ManualConnectButton"
                            MinWidth="110"
                            Style="{DynamicResource AccentButtonStyle}"
                            Click="ManualConnect_Click"
                            Content="{loc:Tr Home.DoConnect}" />
                    <Button Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LinkButton}"
                            Click="Scan_Click"
                            Content="{loc:Tr Home.Scan}" />
                </StackPanel>
                <TextBlock x:Name="ManualMessage" Style="{StaticResource Message}" />
            </StackPanel>

            <!-- Log in to the phone's web interface -->
            <StackPanel x:Name="LoginView" Visibility="Collapsed">
                <TextBlock Style="{StaticResource ViewTitle}" Text="{loc:Tr Home.LoginTitle}" />
                <TextBlock Style="{StaticResource ViewText}" Text="{loc:Tr Home.NeedsLogin}" />

                <TextBlock Style="{StaticResource FieldHeader}" Text="{loc:Tr Phone.Username}" />
                <TextBox x:Name="UserBox" Width="280" HorizontalAlignment="Left" KeyDown="LoginBox_KeyDown" />
                <TextBlock Style="{StaticResource FieldHeader}" Text="{loc:Tr Phone.Password}" />
                <PasswordBox x:Name="PasswordBox" Width="280" HorizontalAlignment="Left" KeyDown="LoginBox_KeyDown" />

                <Button x:Name="LoginButton"
                        Margin="0,20,0,0"
                        MinWidth="110"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="Login_Click"
                        Content="{loc:Tr Home.SignIn}" />
                <TextBlock x:Name="LoginMessage" Style="{StaticResource Message}" />
            </StackPanel>

            <!-- The manufacturer was not recognized -->
            <StackPanel x:Name="VendorView" Visibility="Collapsed">
                <TextBlock Style="{StaticResource ViewTitle}" Text="{loc:Tr Home.VendorTitle}" />
                <TextBlock Style="{StaticResource ViewText}" Text="{loc:Tr Home.VendorUnknown}" />
                <StackPanel x:Name="VendorButtons" Margin="0,20,0,0" Orientation="Horizontal" />
                <TextBlock x:Name="VendorMessage" Style="{StaticResource Message}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
